PAYMENT_WORKER_HEALTH_PORT=3011
# ArcPay runs only for ElevenHouse's company merchant. Provider dispatch is
# intentionally fail-closed: do not deploy this template until every placeholder
# below is replaced with the approved live merchant and private-object-store values.
PAYMENT_WORKER_ARC_PAY_API_BASE_URL=https://api.arcpay.space/v1
PAYMENT_WORKER_ARC_PAY_API_SECRET=replace-with-arc-pay-live-api-secret

NODE_ENV=production

POSTGRES_DB=elevenhouse
POSTGRES_USER=elevenhouse
POSTGRES_PASSWORD=elevenhouse-example-postgres-password-change-before-production
DATABASE_URL=postgresql://elevenhouse:elevenhouse-example-postgres-password-change-before-production@postgres:5432/elevenhouse
REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=elevenhouse
MINIO_ROOT_PASSWORD=elevenhouse-example-minio-password-change-before-production
MINIO_MEDIA_BUCKET=elevenhouse-media
MINIO_PRIVATE_BUCKET=elevenhouse-private
MINIO_APP_USER=eh-media-app
MINIO_APP_PASSWORD=example-minio-app-secret-32-chars
MINIO_API_CORS_ALLOW_ORIGIN=https://astrologer.elevenhouse.ai,https://app.elevenhouse.ai
# The application media bucket stores both public product/profile media and private
# verification documents. Only public media prefixes are anonymously readable.
# MinIO service account constraints: MINIO_APP_USER must be 3-20 characters and
# MINIO_APP_PASSWORD must be 8-40 characters.

AUTH_CODE_DELIVERY_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=

PUBLIC_API_PORT=3001
PUBLIC_API_TRUST_PROXY=true
PUBLIC_API_SESSION_COOKIE_SECURE=true
PUBLIC_API_CSRF_SECRET=elevenhouse-example-public-csrf-secret-change-before-production
PUBLIC_API_ALLOWED_ORIGINS=https://app.elevenhouse.ai
PUBLIC_API_PASSWORDLESS_CODE_SECRET=elevenhouse-example-public-passwordless-secret-change-before-production
PUBLIC_API_PASSWORDLESS_RATE_LIMIT_REDIS_KEY_PREFIX=elevenhouse:public-api
PUBLIC_API_BIRTH_PLACE_SEARCH_ENABLED=true
PUBLIC_API_GEOAPIFY_BASE_URL=https://api.geoapify.com
PUBLIC_API_GEOAPIFY_API_KEY=replace-with-production-geoapify-api-key
PUBLIC_API_BIRTH_PLACE_SEARCH_TIMEOUT_MS=5000
PUBLIC_API_BIRTH_PLACE_SEARCH_CACHE_SUCCESS_TTL_SECONDS=2592000
PUBLIC_API_BIRTH_PLACE_SEARCH_CACHE_EMPTY_TTL_SECONDS=1800
PUBLIC_API_BIRTH_PLACE_SEARCH_LOCK_TTL_MS=6000
PUBLIC_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_REDIS_KEY_PREFIX=elevenhouse:public-api:birth-place-search
PUBLIC_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_USER_PER_MINUTE=20
PUBLIC_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_GLOBAL_PER_MINUTE=120
PUBLIC_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_GLOBAL_PER_DAY=2500

ASTROLOGER_API_PORT=3002
ASTROLOGER_API_FLOW_PUBLICATION_ROLLOUT_PHASE=legacy_v1
ASTROLOGER_API_TRUST_PROXY=true
ASTROLOGER_API_SESSION_COOKIE_SECURE=true
ASTROLOGER_API_CSRF_SECRET=elevenhouse-example-astrologer-csrf-secret-change-before-production
ASTROLOGER_API_ALLOWED_ORIGINS=https://astrologer.elevenhouse.ai
ASTROLOGER_API_PASSWORDLESS_CODE_SECRET=elevenhouse-example-astrologer-passwordless-secret-change-before-production
ASTROLOGER_API_PASSWORDLESS_RATE_LIMIT_REDIS_KEY_PREFIX=elevenhouse:astrologer-api
ASTROLOGER_API_BIRTH_PLACE_SEARCH_ENABLED=true
ASTROLOGER_API_GEOAPIFY_BASE_URL=https://api.geoapify.com
ASTROLOGER_API_GEOAPIFY_API_KEY=replace-with-production-geoapify-api-key
ASTROLOGER_API_BIRTH_PLACE_SEARCH_TIMEOUT_MS=5000
ASTROLOGER_API_BIRTH_PLACE_SEARCH_CACHE_SUCCESS_TTL_SECONDS=2592000
ASTROLOGER_API_BIRTH_PLACE_SEARCH_CACHE_EMPTY_TTL_SECONDS=1800
ASTROLOGER_API_BIRTH_PLACE_SEARCH_LOCK_TTL_MS=6000
ASTROLOGER_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_REDIS_KEY_PREFIX=elevenhouse:astrologer-api:birth-place-search
ASTROLOGER_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_USER_PER_MINUTE=20
ASTROLOGER_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_GLOBAL_PER_MINUTE=120
ASTROLOGER_API_BIRTH_PLACE_SEARCH_RATE_LIMIT_GLOBAL_PER_DAY=2500
ASTROLOGER_MEDIA_STORAGE_ENDPOINT=https://app.elevenhouse.ai
ASTROLOGER_MEDIA_STORAGE_REGION=us-east-1
ASTROLOGER_MEDIA_STORAGE_BUCKET=elevenhouse-media
ASTROLOGER_MEDIA_PRIVATE_STORAGE_BUCKET=elevenhouse-private
ASTROLOGER_MEDIA_STORAGE_ACCESS_KEY_ID=eh-media-app
ASTROLOGER_MEDIA_STORAGE_SECRET_ACCESS_KEY=example-minio-app-secret-32-chars
ASTROLOGER_MEDIA_STORAGE_FORCE_PATH_STYLE=true
# Public media URLs use prefix-scoped anonymous read policies for product/profile
# media only. Verification document prefixes stay private.
ASTROLOGER_MEDIA_STORAGE_PUBLIC_BASE_URL=https://app.elevenhouse.ai/elevenhouse-media
ASTROLOGER_MEDIA_UPLOAD_TTL_SECONDS=900
ASTROLOGER_MEDIA_DOWNLOAD_TTL_SECONDS=300
ASTROLOGER_AI_ENABLED=false
ASTROLOGER_AI_PROVIDER=openai
ASTROLOGER_OPENAI_API_KEY=
ASTROLOGER_OPENAI_BASE_URL=https://api.openai.com/v1
ASTROLOGER_AI_FAST_DRAFT_MODEL=gpt-5.4-mini
ASTROLOGER_AI_QUALITY_DRAFT_MODEL=gpt-5.5
ASTROLOGER_CHART_AI_ENABLED=false
ASTROLOGER_CHART_AI_PROCESSING_AUTHORITY_VERSION=

ADMIN_API_PORT=3003
ADMIN_API_TRUST_PROXY=true
ADMIN_API_ALLOWED_ORIGINS=https://admin.elevenhouse.ai


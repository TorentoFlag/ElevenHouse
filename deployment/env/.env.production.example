CHART_ENGINE_BASE_URL=http://chart-engine:8012
CHART_ENGINE_EXPECTED_EPHEMERIS=swiss-ephemeris
CHART_ENGINE_EXPECTED_EPHEMERIS_FLAGS=FLG_SWIEPH,FLG_SPEED

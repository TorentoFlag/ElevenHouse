{
  "name": "elevenhouse",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "db:generate": "pnpm --filter @elevenhouse/db db:generate",
    "db:migrate": "pnpm --filter @elevenhouse/db db:migrate",
    "db:reset": "pnpm --filter @elevenhouse/db db:reset",
    "db:seed": "pnpm --filter @elevenhouse/db db:seed",
    "db:studio": "pnpm --filter @elevenhouse/db db:studio",
    "dev": "turbo dev --parallel",
    "format": "prettier --write .",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"*.config.{ts,js}\"",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "turbo typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "turbo": "2.9.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.0",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}

  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:preflight-production-baseline": "tsx scripts/production-baseline-preflight.ts",
    "db:repair-production-tariff-entitlements": "tsx scripts/repair-production-tariff-entitlements.ts",
    "db:reset-production-prelaunch": "tsx scripts/production-prelaunch-reset.ts",
    "db:reset": "tsx scripts/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:dev-calendar": "tsx scripts/seed-dev-calendar.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },

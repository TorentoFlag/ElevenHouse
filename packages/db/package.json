{
  "name": "@elevenhouse/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.js"
    },
    "./connection": {
      "types": "./dist/connection/index.d.ts",
      "import": "./dist/connection/index.js",
      "require": "./dist/connection/index.js"
    },
    "./adapters/identity/account-registration": {
      "types": "./dist/adapters/identity/account-registration/index.d.ts",
      "import": "./dist/adapters/identity/account-registration/index.js",
      "require": "./dist/adapters/identity/account-registration/index.js"
    },
    "./adapters/identity/auth-sessions": {
      "types": "./dist/adapters/identity/auth-sessions/index.d.ts",
      "import": "./dist/adapters/identity/auth-sessions/index.js",
      "require": "./dist/adapters/identity/auth-sessions/index.js"
    },
    "./adapters/identity/passwordless-auth": {
      "types": "./dist/adapters/identity/passwordless-auth/index.d.ts",
      "import": "./dist/adapters/identity/passwordless-auth/index.js",
      "require": "./dist/adapters/identity/passwordless-auth/index.js"
    },
    "./account-registration": {
      "types": "./dist/adapters/identity/account-registration/index.d.ts",
      "import": "./dist/adapters/identity/account-registration/index.js",
      "require": "./dist/adapters/identity/account-registration/index.js"
    },
    "./auth-sessions": {
      "types": "./dist/adapters/identity/auth-sessions/index.d.ts",
      "import": "./dist/adapters/identity/auth-sessions/index.js",
      "require": "./dist/adapters/identity/auth-sessions/index.js"
    },
    "./passwordless-auth": {
      "types": "./dist/adapters/identity/passwordless-auth/index.d.ts",
      "import": "./dist/adapters/identity/passwordless-auth/index.js",
      "require": "./dist/adapters/identity/passwordless-auth/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:reset": "tsx scripts/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@elevenhouse/auth": "workspace:*",
    "@types/node": "25.9.2",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@elevenhouse/domain": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "pg": "8.21.0"
  }
}

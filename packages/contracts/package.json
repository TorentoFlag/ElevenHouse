{
  "name": "@elevenhouse/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./products": {
      "types": "./dist/products.d.ts",
      "import": "./dist/products.js",
      "require": "./dist/products.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "require": "./dist/media.js"
    },
    "./calculations": {
      "types": "./dist/calculations.d.ts",
      "import": "./dist/calculations.js",
      "require": "./dist/calculations.js"
    },
    "./numerology": {
      "types": "./dist/numerology.d.ts",
      "import": "./dist/numerology.js",
      "require": "./dist/numerology.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js",
      "require": "./dist/calendar.js"
    },
    "./finance-policies": {
      "types": "./dist/finance-policies.d.ts",
      "import": "./dist/finance-policies.js",
      "require": "./dist/finance-policies.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js",
      "require": "./dist/money.js"
    },
    "./payouts": {
      "types": "./dist/payouts.d.ts",
      "import": "./dist/payouts.js",
      "require": "./dist/payouts.js"
    },
    "./payments": {
      "types": "./dist/payments.d.ts",
      "import": "./dist/payments.js",
      "require": "./dist/payments.js"
    },
    "./reconciliation": {
      "types": "./dist/reconciliation.d.ts",
      "import": "./dist/reconciliation.js",
      "require": "./dist/reconciliation.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elevenhouse/auth": "workspace:*",
    "@elevenhouse/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.2",
    "typescript": "6.0.3"
  }
}

NODE_ENV=development

DATABASE_URL=postgresql://elevenhouse:elevenhouse@localhost:5432/elevenhouse
REDIS_URL=redis://localhost:6379

PUBLIC_API_PORT=3001
PUBLIC_API_SESSION_TTL_SECONDS=604800
PUBLIC_API_SESSION_COOKIE_SECURE=false
PUBLIC_API_SESSION_COOKIE_NAME=elevenhouse_public_session
PUBLIC_API_AUTH_CODE_DELIVERY_PROVIDER=dev
